# .env.local template
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="your-jwt-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# NEW RELIABLE APIS - RapidAPI Key
# Get your RapidAPI key from: https://rapidapi.com/
# This key works for all the reliable APIs: Edmunds, MarketCheck, CIS Automotive, Car Data
RAPIDAPI_KEY="your-rapidapi-key-here"

# App Settings
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# REMOVED UNRELIABLE APIS
# The following APIs have been removed due to reliability issues:
# - EBAY_APP_ID (eBay scraper)
# - CARQUERY API (unreliable)
# - PUPPETEER settings (scrapers removed)
# - All scraper-related environment variables