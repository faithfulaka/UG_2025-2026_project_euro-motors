# .env - COMPLETE ENVIRONMENT VARIABLES FOR EURO MOTORS

# DATABASE (From your MySQL connection screenshot)
DATABASE_URL="mysql://root:@127.0.0.1:3306/euro_motors"

# JWT SECRET (Generate a secure one for production)
JWT_SECRET="euro_motors_jwt_secret_key_change_in_production_2024"

# NEXT.JS
NEXTAUTH_SECRET="euro_motors_nextauth_secret_2024"
NEXTAUTH_URL="http://localhost:3000"

# API RATE LIMITING
CARQUERY_API_RATE_LIMIT=50
SCRAPER_RATE_LIMIT=10

# SCRAPER SETTINGS
PUPPETEER_EXECUTABLE_PATH=""
PLAYWRIGHT_BROWSERS_PATH=""

# EXTERNAL API KEYS (Optional - for enhanced functionality)
# Add these if you want to use premium APIs
EDMUNDS_API_KEY=""
KBB_API_KEY=""
AUTOTRADER_API_KEY=""

# LOGGING
LOG_LEVEL="info"
NODE_ENV="development"

# CACHING
REDIS_URL=""
CACHE_TTL="3600"

# EMAIL (For notifications - optional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""