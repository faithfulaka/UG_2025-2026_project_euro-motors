# .env - Euro Motors Environment Variables

# Database Configuration (MySQL)
DATABASE_URL="mysql://root:your_mysql_password@127.0.0.1:3306/euro_motors"

# JWT Secret for Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production-euro-motors-2024"

# Node Environment
NODE_ENV="development"

# Next.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-euro-motors"

# API Keys (Optional - for enhanced scraping)
CARQUERY_API_KEY=""
AUTOTRADER_API_KEY=""

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# Cache Configuration
CACHE_TTL_MINUTES="30"
REDIS_URL=""

# Email Configuration (for notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Webhook URLs (for external integrations)
WEBHOOK_SECRET=""

# Debug Settings
DEBUG_MODE="true"
LOG_LEVEL="info"